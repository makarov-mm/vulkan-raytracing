#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(set = 0, binding = kBindingScene) uniform accelerationStructureEXT scene;
layout(set = 0, binding = kBindingOutput, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = kBindingAccumulation, rgba32f) uniform image2D accumulation;

layout(push_constant) uniform PushConstants { FrameConstants frame; };

layout(location = 0) rayPayloadEXT HitPayload hit;
layout(location = 1) rayPayloadEXT uint shadowed;

// ---- Look ------------------------------------------------------------------
const float IOR[3] = float[](1.50, 1.52, 1.54);  // per channel; exaggerated dispersion
const float GLASS_R0 = 0.0426;                    // Schlick reflectance at normal incidence, ((1 - 1.52) / (1 + 1.52))^2
const float GLASS_TRANSMITTANCE = 0.98;           // light absorption per glass interaction
const float LIGHT_INTENSITY = 1.4;                // direct light on diffuse surfaces
const float LIGHT_EMISSION = 3.0;                 // brightness of the visible light sphere
const float AMBIENT = 0.12;
const int SHADOW_SAMPLES = 4;                     // shadow rays per diffuse hit

const float RAY_EPSILON = 1e-3;
const float RAY_TMAX = 1e4;

// ---- Random numbers (PCG, Jarzynski & Olano 2020) --------------------------

uint pcgStep(uint state) {
    return state * 747796405u + 2891336453u;
}

uint pcgOutput(uint state) {
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint pcgHash(uint v) {
    return pcgOutput(pcgStep(v));
}

// Uniform float in [0, 1).
float random(inout uint state) {
    state = pcgStep(state);
    return float(pcgOutput(state) >> 8u) * (1.0 / 16777216.0);
}

// ---- Helpers ---------------------------------------------------------------

vec3 sky(vec3 dir) {
    return mix(vec3(0.90, 0.95, 1.00), vec3(0.25, 0.45, 0.85), 0.5 * (dir.y + 1.0));
}

vec3 checker(vec3 p) {
    return mix(vec3(0.85), vec3(0.10), mod(floor(p.x) + floor(p.z), 2.0));
}

float pow5(float x) {
    float x2 = x * x;
    return x2 * x2 * x;
}

// Orthonormal basis around a unit vector (Duff et al. 2017).
void basis(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

// Uniform direction inside the cone of half-angle acos(cosMax) around `axis`.
vec3 sampleCone(vec3 axis, float cosMax, inout uint rng) {
    float cosTheta = mix(1.0, cosMax, random(rng));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 6.28318531 * random(rng);
    vec3 t, b;
    basis(axis, t, b);
    return normalize((t * cos(phi) + b * sin(phi)) * sinTheta + axis * cosTheta);
}

bool occluded(vec3 origin, vec3 dir, float tMax) {
    shadowed = 1u;
    traceRayEXT(scene,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                0xFF, 0, 0, 1, origin, RAY_EPSILON, dir, tMax, 1);
    return shadowed != 0u;
}

// Diffuse light from the spherical area light: sampling the cone it subtends
// gives soft shadows whose penumbra widens with the occluder's distance.
float directLight(vec3 position, vec3 n, inout uint rng) {
    vec3 toLight = frame.light.xyz - position;
    float dist = length(toLight);
    vec3 axis = toLight / dist;
    float sinMax = min(frame.light.w / dist, 0.999);
    float cosMax = sqrt(1.0 - sinMax * sinMax);
    float tMax = max(dist - frame.light.w * 1.001, RAY_EPSILON);  // stop short of the light sphere
    vec3 origin = position + n * RAY_EPSILON;

    float sum = 0.0;
    for (int i = 0; i < SHADOW_SAMPLES; ++i) {
        vec3 l = sampleCone(axis, cosMax, rng);
        float cosine = dot(n, l);
        if (cosine > 0.0 && !occluded(origin, l, tMax)) sum += cosine;  // no ray for back-facing samples
    }
    return sum / float(SHADOW_SAMPLES) * LIGHT_INTENSITY;
}

// ---- Path ------------------------------------------------------------------

// One jittered camera path. Refraction is traced for a single "hero" colour
// channel chosen by the sample index, so consecutive samples cover R, G and B
// equally and the glass disperses light.
vec3 tracePath(uint sampleIndex, inout uint rng) {
    vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(random(rng), random(rng));
    vec2 ndc = pixel / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;  // y = -1 at the top row
    vec3 origin = frame.eye.xyz;
    vec3 dir = normalize(frame.forward.xyz + ndc.x * frame.right.xyz - ndc.y * frame.up.xyz);

    uint hero = sampleIndex % 3u;
    bool dispersed = false;
    vec3 color = vec3(0.0);
    vec3 throughput = vec3(1.0);

    for (uint bounce = 0u; bounce <= frame.counters.w; ++bounce) {
        traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, RAY_EPSILON, dir, RAY_TMAX, 0);
        if (hit.t < 0.0) {
            color += throughput * sky(dir);
            break;
        }

        vec3 position = origin + dir * hit.t;
        vec3 n = hit.normal;

        if (hit.material == kMaterialEmissive) {
            color += throughput * hit.albedo * LIGHT_EMISSION;
            break;
        }

        if (hit.material == kMaterialGlass) {
            bool entering = hit.frontFace != 0u;
            vec3 refracted = refract(dir, n, entering ? 1.0 / IOR[hero] : IOR[hero]);
            bool totalReflection = dot(refracted, refracted) < 1e-6;
            // Schlick's approximation needs the angle on the optically thinner
            // (air) side: the incident one when entering, the refracted one when leaving.
            float cosine = entering ? clamp(dot(-dir, n), 0.0, 1.0) : clamp(-dot(refracted, n), 0.0, 1.0);
            float fresnel = totalReflection ? 1.0 : GLASS_R0 + (1.0 - GLASS_R0) * pow5(1.0 - cosine);

            if (random(rng) < fresnel) {
                dir = reflect(dir, n);  // reflection keeps all colours
                origin = position + n * RAY_EPSILON;
            } else {
                dir = normalize(refracted);
                origin = position - n * RAY_EPSILON;
                if (!dispersed) {  // from now on the path carries only the hero channel
                    vec3 mask = vec3(0.0);
                    mask[hero] = 3.0;
                    throughput *= mask;
                    dispersed = true;
                }
            }
            throughput *= GLASS_TRANSMITTANCE;
            continue;
        }

        // Diffuse surface with an optional mirror layer.
        vec3 albedo = hit.material == kMaterialChecker ? checker(position) : hit.albedo;
        float reflectivity = hit.reflectivity;
        color += throughput * albedo * (AMBIENT + directLight(position, n, rng)) * (1.0 - reflectivity);
        if (reflectivity <= 1e-3) break;

        throughput *= reflectivity;
        dir = reflect(dir, n);
        origin = position + n * RAY_EPSILON;
    }
    return color;
}

void main() {
    uint samples = max(frame.counters.z, 1u);
    vec3 sum = vec3(0.0);
    for (uint s = 0u; s < samples; ++s) {
        // The frame index never resets, so the noise keeps changing during camera motion.
        uint sampleIndex = frame.counters.y * samples + s;
        uint rng = pcgHash(gl_LaunchIDEXT.x + pcgHash(gl_LaunchIDEXT.y + pcgHash(sampleIndex)));
        sum += tracePath(sampleIndex, rng);
    }
    vec3 color = sum / float(samples);

    // Progressive refinement: running average while the camera stands still.
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint accumulated = frame.counters.x;
    if (accumulated > 0u) {
        color = mix(imageLoad(accumulation, pixel).rgb, color, 1.0 / float(accumulated + 1u));
    }
    imageStore(accumulation, pixel, vec4(color, 1.0));
    imageStore(outputImage, pixel, vec4(pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2)), 1.0));
}
